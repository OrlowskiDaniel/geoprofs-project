<Window x:Class="GeoProfs.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GeoProfs.Desktop.ViewModels"
        Title="GeoProfs Desktop" Height="220" Width="420">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <StackPanel Margin="24">
        <TextBlock Text="GeoProfs — WPF Client" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="This message came from the same Laravel API the React app uses:"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Message}"
                   FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
