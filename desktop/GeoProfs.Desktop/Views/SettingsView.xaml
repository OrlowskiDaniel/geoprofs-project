<UserControl x:Class="GeoProfs.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F5F5">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->

        <StackPanel Grid.Row="0" Margin="0,0,0,25">

            <TextBlock Text="Settings"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#202938"/>

            <TextBlock Text="Manage your application preferences"
                       FontSize="13"
                       Foreground="#777777"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- top nav -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="5"
                Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal">

                <RadioButton Content="General"
                             GroupName="SettingsTabs"
                             IsChecked="True"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="General"
                             Padding="20,12"
                             Cursor="Hand"/>

                <RadioButton Content="Planning"
                             GroupName="SettingsTabs"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="Planning"
                             Padding="20,12"
                             Cursor="Hand"/>

                <RadioButton Content="Notifications"
                             GroupName="SettingsTabs"
                             Command="{Binding SelectTabCommand}"
                             CommandParameter="Notifications"
                             Padding="20,12"
                             Cursor="Hand"/>

            </StackPanel>

        </Border>

        <!-- settings -->

        <Grid Grid.Row="2">

            <!-- generals -->

            <Border Background="White"
                    CornerRadius="8"
                    Padding="25">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}"
                                         Value="General">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock Text="General settings"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Manage general application preferences."
                               Foreground="#777777"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Language"
                               FontWeight="SemiBold"/>

                    <ComboBox Width="250"
                              HorizontalAlignment="Left"
                              SelectedIndex="0"
                              Margin="0,7,0,0">

                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Dutch"/>

                    </ComboBox>

                </StackPanel>

            </Border>

            <!-- planning settings -->

            <Border Background="White"
                    CornerRadius="8"
                    Padding="25">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}"
                                         Value="Planning">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock Text="Planning settings"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Configure employee staffing thresholds for the calendar."
                               Foreground="#777777"
                               Margin="0,0,0,25"/>

                    <!-- not enough -->

                    <Border BorderBrush="#E5E5E5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Not enough employees"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>

                                <TextBlock Text="Days with this number or fewer employees will be red."
                                           Foreground="#777777"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <TextBox Grid.Column="1"
                                     Text="{Binding PlanningSettings.NotEnoughMax,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     Width="65"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- okey / busy -->

                    <Border BorderBrush="#E5E5E5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15"
                            Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Okay / Busy"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>

                                <TextBlock Text="Days above the red threshold and up to this number will be yellow."
                                           Foreground="#777777"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                            <TextBox Grid.Column="1"
                                     Text="{Binding PlanningSettings.OkayMax,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     Width="65"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"/>

                        </Grid>

                    </Border>

                    <!-- optimal -->

                    <Border BorderBrush="#E5E5E5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Optimal"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>

                            <TextBlock Text="Days above the Okay / Busy threshold will have a white background."
                                       Foreground="#777777"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

            <!-- notification settings -->

            <Border Background="White"
                    CornerRadius="8"
                    Padding="25">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}"
                                         Value="Notifications">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <TextBlock Text="Notification settings"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Manage which notifications you would like to receive."
                               Foreground="#777777"
                               Margin="0,0,0,25"/>

                    <CheckBox Content="Notify me about new requests"
                              IsChecked="True"
                              Margin="0,0,0,15"/>

                    <CheckBox Content="Notify me about unanswered leave requests(3 days)"
                              IsChecked="True"
                              Margin="0,0,0,15"/>

                    <CheckBox Content="Notify me about understaffed days"
                              IsChecked="True"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
