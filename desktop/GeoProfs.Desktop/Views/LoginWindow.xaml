<Window x:Class="GeoProfs.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoProfs - Login"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <Border Width="320"
                Padding="30"
                Background="White"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="GeoProfs"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#6264A7"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Sign in to your account"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="35"
                             Padding="8"
                             Margin="0,0,0,10"/>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D32F2F"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- Login -->
                <Button Content="Sign in"
                        Height="40"
                        Background="#6264A7"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>

            </StackPanel>

        </Border>
    </Grid>
</Window>