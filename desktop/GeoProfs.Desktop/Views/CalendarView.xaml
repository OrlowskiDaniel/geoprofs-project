<UserControl x:Class="GeoProfs.Desktop.Views.CalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:GeoProfs.Desktop.Models"
    Background="#F5F6FA">

    <UserControl.Resources>

        <!-- calendar day style -->
        <Style x:Key="CalendarDayStyle"
               TargetType="Button">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <!-- not enough employees -->
                <DataTrigger Binding="{Binding Status}"
                             Value="{x:Static models:StaffingStatus.NotEnough}">
                    <Setter Property="Background"
                            Value="#F8B4B4"/>
                </DataTrigger>

                <!-- okay / busy -->
                <DataTrigger Binding="{Binding Status}"
                             Value="{x:Static models:StaffingStatus.Okay}">
                    <Setter Property="Background"
                            Value="#FFE58A"/>
                </DataTrigger>

                <!-- optimal -->
                <DataTrigger Binding="{Binding Status}"
                             Value="{x:Static models:StaffingStatus.Optimal}">
                    <Setter Property="Background"
                            Value="White"/>
                </DataTrigger>

                <!-- days outside the current month -->
                <DataTrigger Binding="{Binding IsCurrentMonth}"
                             Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>

                <!-- today date -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

                <!-- selected day -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

                <!-- highlight date -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- month title and navigation -->

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Planning Calendar"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#202938"/>

                <TextBlock Text="{Binding MonthTitle}"
                           FontSize="15"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="&#x276E;"
                        Width="40"
                        Height="35"
                        Margin="3"
                        Command="{Binding PreviousMonthCommand}"/>

                <Button Content="&#x276F;"
                        Width="40"
                        Height="35"
                        Margin="3"
                        Command="{Binding NextMonthCommand}"/>

            </StackPanel>

        </Grid>

        <!-- weekday headers -->

        <Border Grid.Row="1"
                Background="#A9D8F5"
                CornerRadius="6,6,0,0">

            <UniformGrid Columns="7">

                <TextBlock Text="Monday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Tuesday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Wednesday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Thursday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Friday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Saturday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Sunday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

            </UniformGrid>
        </Border>

        <!-- calender days -->

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Days}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Button Style="{StaticResource CalendarDayStyle}"
                            Command="{Binding DataContext.SelectDayCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">

                        <StackPanel>

                            <TextBlock Text="{Binding DayNumber}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding EmployeeCount,
                                           StringFormat='Employees: {0}'}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Button>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        

    </Grid>

</UserControl>
