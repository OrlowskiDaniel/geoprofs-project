<UserControl x:Class="GeoProfs.Desktop.Views.CalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:GeoProfs.Desktop.Models"
    Background="#F5F6FA">

    <UserControl.Resources>

        <!-- calendar day style -->
        <Style x:Key="CalendarDayStyle"
               TargetType="Button">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>

                <!-- days outside the current month -->
                <DataTrigger Binding="{Binding IsCurrentMonth}"
                             Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>

                <!-- today date -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

                <!-- selected day -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

                <!-- highlight date -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </DataTrigger>

                <!-- RED: not enough people -->
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StaffingStatus.NotEnough}">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                </DataTrigger>

                <!-- YELLOW: okay -->
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StaffingStatus.Okay}">
                    <Setter Property="Background" Value="#FEF3C7"/>
                    <Setter Property="BorderBrush" Value="#D97706"/>
                </DataTrigger>

                <!-- GREEN: optimal -->
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StaffingStatus.Optimal}">
                    <Setter Property="Background" Value="#DCFCE7"/>
                    <Setter Property="BorderBrush" Value="#16A34A"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- month title and navigation -->

        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Planning Calendar"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#202938"/>

                <TextBlock Text="{Binding MonthTitle}"
                           FontSize="15"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="&#x276E;"
                        Width="40"
                        Height="35"
                        Margin="3"
                        Command="{Binding PreviousMonthCommand}"/>

                <Button Content="&#x276F;"
                        Width="40"
                        Height="35"
                        Margin="3"
                        Command="{Binding NextMonthCommand}"/>

            </StackPanel>

        </Grid>

        <!-- weekday headers -->

        <Border Grid.Row="1"
                Background="#A9D8F5"
                CornerRadius="6,6,0,0">

            <UniformGrid Columns="7">

                <TextBlock Text="Monday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Tuesday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Wednesday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Thursday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Friday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Saturday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

                <TextBlock Text="Sunday"
                           Padding="8"
                           FontWeight="Bold"
                           TextAlignment="Center"/>

            </UniformGrid>
        </Border>

        <!-- calender days -->

        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Days}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Button Style="{StaticResource CalendarDayStyle}"
                            Command="{Binding DataContext.SelectDayCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">

                        <StackPanel>

                            <TextBlock Text="{Binding DayNumber}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#202938"/>

                            <TextBlock Text="{Binding EmployeeCount,
                                       StringFormat={}{0} employees}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding AbsentCount,
                                       StringFormat={}{0} absent}"
                               FontSize="11"
                               Foreground="#6B7280"
                               Margin="0,3,0,0"/>

                        </StackPanel>

                    </Button>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <Border Grid.Row="3"
                Margin="0,15,0,0"
                Padding="12"
                Background="White"
                BorderBrush="#D5D9E0"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Monthly staffing summary"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="#202938"/>

                <TextBlock Text="{Binding IsLoading,
                                    StringFormat='Loading staffing data: {0}'}"
                           Margin="0,5,0,0"
                           Foreground="#6B7280"/>

                <TextBlock Text="{Binding PlanningError}"
                           Margin="0,5,0,0"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"/>

                <WrapPanel DataContext="{Binding PlanningSummary}"
                           Margin="0,8,0,0">
                    <TextBlock Text="{Binding Department,
                                                StringFormat='Department: {0}'}"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding TotalEmployees,
                                                StringFormat='Total employees: {0}'}"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Present,
                                                StringFormat='Present: {0}'}"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Absent,
                                                StringFormat='Absent: {0}'}"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding MinimumPresence,
                                                StringFormat='Minimum presence: {0}'}"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding MinimumMet,
                                                StringFormat='Minimum met: {0}'}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
