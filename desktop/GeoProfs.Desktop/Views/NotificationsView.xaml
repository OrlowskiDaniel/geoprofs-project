<UserControl x:Class="GeoProfs.Desktop.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Notifications"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="#252525"
                   Margin="28,24,28,16" />

        <TextBlock Grid.Row="1"
                   Text="Loading notifications..."
                   FontSize="14"
                   Foreground="#666666"
                   Margin="28,0,28,12"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border Grid.Row="2"
                Background="#FDE8E7"
                BorderBrush="#D13438"
                BorderThickness="1"
                CornerRadius="4"
                Margin="28,0,28,12"
                Padding="12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#A4262C" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="28,0,28,24">
            <TextBlock Text="No notifications to display."
                       FontSize="14"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Notifications.Count}" Value="0" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#E1E1E1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1" />
                                                <Setter Property="BorderBrush" Value="#D9A300" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#xE7F4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="22"
                                               Foreground="#6264A7"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Top" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#252525"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:MMM d, yyyy h:mm tt}'}"
                                                   FontSize="12"
                                                   Foreground="#666666"
                                                   Margin="0,8,0,0" />
                                        <TextBlock FontSize="12" Foreground="#666666" Margin="0,4,0,0">
                                            <Run Text="Leave request: " />
                                            <Run Text="{Binding LeaveRequestId}" />
                                            <Run Text="   Type: " />
                                            <Run Text="{Binding NotificationTypeId}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Mark as read"
                                            Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsUnread}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Padding="12,6" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
